# Copy to .env for local dev (docker-compose sets these directly).

# Server
PORT=8080
DB_PATH=./data/arm.sqlite
WEB_DIST=../web/dist

# Adapter selection — swap a single value to go live (see docs/ADAPTERS.md).
FLIGHT_SOURCE=mock-aidx        # mock-aidx | vendor-api
QUEUE_SOURCE=mock-acris        # mock-acris | acris-ngsi
CREATIVE_PROVIDER=mock-template # mock-template | openai

# GenAI (only used when CREATIVE_PROVIDER=openai; demo works with no key)
OPENAI_API_KEY=

# White-label + i18n
BRAND_NAME=SkyReach
BRAND_COLOR=#4f8cff
SECOND_LANGUAGE=ar             # BCP-47 code for the configurable second language
CURRENCY=USD

# QR claim page: set to the laptop's LAN URL so a phone on the same network can
# scan and claim, e.g. http://192.168.1.50:8080 . Empty = use request origin.
PUBLIC_BASE_URL=

# Simulation
SIM_START=2026-03-14T06:00:00Z
SIM_SPEED=10
